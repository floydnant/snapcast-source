# Copy to .env and edit. .env is gitignored.
# Plain make assignments: no quotes, no trailing comments.

# Host running snapserver + the relay. Hostname or IP. Used by `make stream`.
SERVER=snapserver.local

# ssh destination for `make deploy-relay`, if different from SERVER
# (e.g. an alias from ~/.ssh/config).
# SSH_HOST=my-server

# Must match the relay's -listen port.
PORT=4953

# Exact device name for the legacy snapcap path, as listed by `make devices`.
DEVICE=BlackHole 16ch
